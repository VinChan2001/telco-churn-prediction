FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY data/processed/model_metrics.csv data/processed/model_metrics.csv
COPY data/processed/shap_feature_importance.csv data/processed/shap_feature_importance.csv
COPY data/processed/scored_churn_customers.csv data/processed/scored_churn_customers.csv

CMD ["streamlit", "run", "app/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8080", "--server.headless=true", "--browser.gatherUsageStats=false"]
